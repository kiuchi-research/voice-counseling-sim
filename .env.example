# Copy this file to .env and enter only the credentials for providers you use.
# The bundled Realtime configuration defaults to Azure OpenAI.
OPENAI_API_KEY=

# Optional OpenAI model overrides. Availability depends on your API account.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_PROMPTING_MODEL=gpt-5.4-mini
OPENAI_TIMING_MODEL=gpt-5.4-mini
OPENAI_SUMMARY_MODEL=gpt-5.4-mini
OPENAI_TEXT_MODEL=gpt-5.1
OPENAI_TEXT_REASONING_EFFORT=low
OPENAI_EVALUATION_MODEL=gpt-5-nano
OPENAI_EVALUATION_REASONING_EFFORT=low
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_FALLBACK_MODEL=tts-1

# Azure: resource endpoint and deployment names from your Azure resource.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=
AZURE_OPENAI_TEXT_DEPLOYMENT=
AZURE_OPENAI_STT_DEPLOYMENT=
